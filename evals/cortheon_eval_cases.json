        }
      ],
      "max_search_results": 0,
      "max_scholarly_results": 6,
      "max_github_results": 0,
      "max_trial_results": 3,
      "seed_url_count": 0,
      "min_source_decisions": 6,
      "required_selected_sources": [
        "clinicaltrials_gov",
        "pubmed"
      ],
      "required_skipped_sources": [
        "web_search",
        "seed_urls"
      ]
    },
    {
      "id": "alife_research_synthesis_finds_relevant_works",
      "kind": "research_synthesis",
      "topic": "open-ended artificial life evolution benchmark",
      "max_scholarly_results": 8,
      "max_github_results": 0,
      "max_follow_up_queries": 2,
      "max_adaptive_queries": 1,
      "max_pages": 0,
