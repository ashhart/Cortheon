# Source-archive allowlist. setup.py enforces the final contents.

include LICENSE
include MANIFEST.in
include README.md
include pyproject.toml
include setup.py
include build_backend.py
recursive-include build_support *.py

include src/cortheon/__init__.py
include src/cortheon/cognitive_cli.py
include src/cortheon/cognitive_graph.py
include src/cortheon/cognitive_hooks.py
include src/cortheon/cognitive_http.py
include src/cortheon/cognitive_install.py
include src/cortheon/cognitive_mcp.py
include src/cortheon/cognitive_program.py
include src/cortheon/cognitive_protocol.py
include src/cortheon/cognitive_repair.py
include src/cortheon/cognitive_runtime.py
include src/cortheon/omp_host.py
include src/cortheon/sanitize.py

recursive-include src/cortheon/cognitive_core *.py
recursive-include src/cortheon/cognitive_cli_core *.py
recursive-include src/cortheon/cognitive_install_core *.py
recursive-include src/cortheon/cognitive_hooks_core *.py
recursive-include src/cortheon/cognitive_mcp_core *.py
include src/cortheon/opencode_plugin.js
recursive-include src/cortheon/opencode_core *.js
include src/cortheon/pi_extension.ts
recursive-include src/cortheon/pi_core *.ts

# The Codex plugin ships whole, minus the console-script shim the wheel's own
# entry point replaces and the agent profile that is not Codex's.
recursive-include src/cortheon/codex_plugins/cortheon *
exclude src/cortheon/codex_plugins/cortheon/scripts/cortheon-mcp
exclude src/cortheon/codex_plugins/cortheon/skills/cortheon-runtime/agents/openai.yaml

global-exclude __pycache__ *.py[cod]
